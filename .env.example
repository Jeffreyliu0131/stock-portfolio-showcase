# Copy this file to .env.local. Never commit the copied file or real values.
# All credentials are read on the server. Never rename them with NEXT_PUBLIC_ or VITE_ prefixes.

# Keep AI disabled until a server-side provider key and budget are configured.
PORTFOLIO_AI_ENABLED=false
DEEPSEEK_API_KEY=replace-with-your-server-only-key

# Evidence-grounded Buffett research for AAPL/MSFT.
BUFFETT_RESEARCH_ENABLED=false
OPENAI_API_KEY=replace-with-your-server-only-key
OPENAI_RESEARCH_MODEL=gpt-5.5
SEC_RESEARCH_USER_AGENT=StockPortfolioResearch/0.1 contact@example.com

# Optional delayed market data and instrument resolution.
ALPACA_API_KEY_ID=replace-with-your-server-only-id
ALPACA_API_SECRET_KEY=replace-with-your-server-only-secret
ALPACA_TRADING_API_BASE_URL=https://paper-api.alpaca.markets
