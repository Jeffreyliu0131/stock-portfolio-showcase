{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "application/**/*.ts",
    "application/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "db/**/*.ts",
    "domain/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "ui/**/*.ts",
    "ui/**/*.tsx",
    "worker/**/*.ts",
    "types/**/*.d.ts",
    "vite.config.ts",
    "drizzle.config.ts",
    ".next/types/routes.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "scripts/deployment-config.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
